# Supabase self-hosted fuer Agora — Vorlage. Kopieren nach `.env` und fuellen:
#
#   cp .env.example .env
#
# Alle Secret-Felder sind bewusst LEER. Werte kommen aus Vaultwarden
# (`vw get <name>`), nie aus dieser Datei und nie aus einem Commit.
# `.env` ist in `.gitignore` und darf das Repository nie erreichen.
#
# JWT-Schluessel erzeugen: https://supabase.com/docs/guides/self-hosting/docker
# Zufallswerte erzeugen: `openssl rand -base64 48 | tr -d '\n'`

# ---------------------------------------------------------------------------
# Secrets — ohne Ausnahme selbst erzeugen, nie Beispielwerte uebernehmen
# ---------------------------------------------------------------------------

# Passwort des Postgres-Superusers. Mindestens 32 Zeichen.
POSTGRES_PASSWORD=

# HS256-Secret, mit dem GoTrue, PostgREST und Storage JWTs signieren/pruefen.
# Mindestens 32 Zeichen.
JWT_SECRET=

# Die beiden Legacy-API-Schluessel: JWTs, die mit JWT_SECRET signiert sind und
# `role: anon` bzw. `role: service_role` tragen.
# ANON_KEY  -> nur Frontend.
# SERVICE_ROLE_KEY -> ausschliesslich das Flask-Backend. Nie ins Frontend,
# nie in ein Image, nie in einen Log.
ANON_KEY=
SERVICE_ROLE_KEY=

# Phoenix-Secret fuer Supavisor. `openssl rand -base64 48`
SECRET_KEY_BASE=

# Vault-Verschluesselungsschluessel fuer Supavisor. Genau 32 Zeichen.
VAULT_ENC_KEY=

# Verschluesselungsschluessel fuer postgres-meta/Studio. Mindestens 32 Zeichen.
PG_META_CRYPTO_KEY=

# Basic-Auth vor dem Studio-Dashboard am Gateway.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# S3-Protokoll-Zugang von Storage. Leer lassen, solange kein S3-Client
# gegen Storage spricht.
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------

# Servicename im Compose-Netz, kein Hostname des Docker-Hosts.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Pooler (Supavisor)
# ---------------------------------------------------------------------------

POOLER_TENANT_ID=agora
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# ---------------------------------------------------------------------------
# API / URLs
# ---------------------------------------------------------------------------

# Nach aussen sichtbare Basis-URL des Gateways. Die Defaults sind lokal und
# machen einen Erstlauf ohne weitere Konfiguration moeglich; hinter einem
# Reverse Proxy auf dessen Adresse setzen (z. B. https://supabase.example.tld).
# Leer lassen geht nicht: GoTrue signiert damit den JWT-Issuer, Storage baut
# daraus seine Public-URLs.
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
API_EXTERNAL_URL=http://127.0.0.1:8000

# Origin der Agora-Oberflaeche, fuer GoTrue-Redirects.
SITE_URL=http://127.0.0.1:5173
ADDITIONAL_REDIRECT_URLS=

# Host-Bind des Gateways. Default 127.0.0.1 — extern nur ueber Reverse Proxy.
# Nur bewusst aendern (z. B. auf eine Tailscale-Adresse).
SUPABASE_BIND_HOST=127.0.0.1
API_GW_HTTP_PORT=8000

# ---------------------------------------------------------------------------
# Auth (GoTrue) — Single User bis 1.0, deshalb Registrierung zu
# ---------------------------------------------------------------------------

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true
JWT_EXPIRY=3600

# ---------------------------------------------------------------------------
# PostgREST
# ---------------------------------------------------------------------------

# Hier steht bewusst noch kein `agora`. Das Zielschema des Datenmodells
# (Plan §9) entsteht erst in Phase 3; ein Schema, das es nicht gibt, laesst
# PostgREST dauerhaft unhealthy laufen ("schema \"agora\" does not exist",
# Retry-Schleife). Mit der ersten Alembic-Migration erweitern auf:
#   PGRST_DB_SCHEMAS=public,storage,graphql_public,agora
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_DB_MAX_ROWS=1000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

STORAGE_TENANT_ID=agora
REGION=local
GLOBAL_S3_BUCKET=stub
# 50 MiB
STORAGE_FILE_SIZE_LIMIT=52428800

# ---------------------------------------------------------------------------
# Studio
# ---------------------------------------------------------------------------

STUDIO_DEFAULT_ORGANIZATION=Agora
STUDIO_DEFAULT_PROJECT=Agora

# ---------------------------------------------------------------------------
# Image-Tags (nur aendern, wenn bewusst aktualisiert wird)
# ---------------------------------------------------------------------------

# Muessen zu SUPABASE_REF in bootstrap.sh passen: die Config-Dateien unter
# `volumes/` stammen aus demselben Supabase-Stand wie diese Images.
POSTGRES_IMAGE=supabase/postgres:17.6.1.136
SUPAVISOR_IMAGE=supabase/supavisor:2.9.12
GOTRUE_IMAGE=supabase/gotrue:v2.196.0
POSTGREST_IMAGE=postgrest/postgrest:v14.17
STORAGE_IMAGE=supabase/storage-api:v1.74.0
POSTGRES_META_IMAGE=supabase/postgres-meta:v0.99.0
STUDIO_IMAGE=supabase/studio:2026.09.07-sha-7996410
ENVOY_IMAGE=envoyproxy/envoy:v1.39.1
