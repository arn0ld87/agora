# =============================================================
# Agora Configuration
# =============================================================
# Agora is local-first and cloud-compatible; optional cloud model endpoints can be used.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== Flask / Security =====
# Pflicht im Nicht-Debug-Betrieb. Erzeuge einen neuen Wert mit:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Bekannte Platzhalter (`change-me`, `change-me-use-token_urlsafe-32`,
# `agora`, `password`) lehnt Config.validate() im Nicht-Debug-Modus hart ab.
SECRET_KEY=change-me-use-token_urlsafe-32

# Secure-by-default: false. Auf true setzen für lokale Entwicklung mit
# Hot-Reload und Tracebacks in API-Responses. Niemals in Prod aktivieren.
FLASK_DEBUG=false

# Bind-Adresse des Flask-Servers. Default: 127.0.0.1 (nur lokal erreichbar).
# Im Docker-Container setzt das Dockerfile automatisch 0.0.0.0.
# FLASK_HOST=127.0.0.1

# API-Token-Schutz für /api/*. Pflicht außerhalb von FLASK_DEBUG=true.
# Clients senden Header `Authorization: Bearer <token>` oder `X-Agora-Token: <token>`.
# Token mit `python -c "import secrets; print(secrets.token_urlsafe(32))"` erzeugen.
# AGORA_AUTH_TOKEN=

# App-seitiges Fixed-Window-Limit fuer Signed-Ticket-Issuance.
# Defaults: 60 Requests pro 60 Sekunden und Remote-Adresse.
AGORA_TICKET_RATE_LIMIT_MAX=60
AGORA_TICKET_RATE_LIMIT_WINDOW_SECONDS=60
# Upload-Limit fuer POST /api/graph/ontology/generate.
# Defaults: 10 Requests pro 60 Sekunden und Remote-Adresse.
AGORA_UPLOAD_RATE_LIMIT_MAX=10
AGORA_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
# LLM-Trigger-Limit fuer POST /api/simulation/generate-profiles und /prepare.
# Defaults: 20 Requests pro 60 Sekunden und Remote-Adresse/Endpoint.
AGORA_LLM_TRIGGER_RATE_LIMIT_MAX=20
AGORA_LLM_TRIGGER_RATE_LIMIT_WINDOW_SECONDS=60
# Report-Limit fuer POST /api/report/generate und /chat.
# Defaults: 10 Requests pro 60 Sekunden und Remote-Adresse/Endpoint.
AGORA_REPORT_RATE_LIMIT_MAX=10
AGORA_REPORT_RATE_LIMIT_WINDOW_SECONDS=60

# Opt-out für offene Lab-Setups. Nur setzen, wenn der Endpunkt bewusst
# unauthentifiziert sein soll (z.B. lokales Klassenraum-Demo). Niemals in Prod.
# AGORA_ALLOW_ANONYMOUS=true

# Zusätzliche erlaubte Frontend-Origins (kommagetrennt), z.B. Tailscale / LAN.
# AGORA_EXTRA_ORIGINS=http://100.64.0.10:5173,https://agora.tailnet.example

# ===== Docker-Compose Dev-Ports =====
# Host-Bind-Adresse für Dev-Container-Ports. Default: 127.0.0.1 (nur lokal erreichbar).
# Auf 0.0.0.0 setzen für Tailscale/LAN-Zugriff (bewusster Opt-out).
# AGORA_BIND_HOST=127.0.0.1
# AGORA_FRONTEND_PORT=5173
# AGORA_BACKEND_PORT=5001
# Compose-DNS-Server fuer Container, falls der Host eigene Resolver braucht.
# AGORA_DNS_PRIMARY=8.8.8.8
# AGORA_DNS_SECONDARY=8.8.4.4

# ===== Docker-Compose Build-Args (Prod) =====
# Build-Time-Token-Gate: Bei `true` wird VITE_AGORA_TOKEN ins Frontend-Bundle
# einkompiliert (nur Single-User-Tailnet). Default `false` → Runtime-Login.
# Siehe docu/security-hardening.md → F2.1
# ALLOW_BUILD_TIME_TOKEN=false
# VITE_AGORA_TOKEN=

# ===== LLM Configuration (OpenAI-compatible format) =====
# Points to local Ollama server. Any non-empty value for API key works.
# In Docker, Agora reaches host Ollama through host.docker.internal.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:32b
# Lighter model for development (less VRAM):
# LLM_MODEL_NAME=qwen2.5:14b

# ===== Neo4j Configuration =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Pflichtfeld. Kein Default mehr — docker-compose bricht bei leerem Wert ab.
# Bekannte Platzhalter (`change-me`, `agora`, `neo4j`, `password`) werden im
# Nicht-Debug-Betrieb von Config.validate() hart abgelehnt.
NEO4J_PASSWORD=change-me
# Compose-Defaults fuer Neo4j. Nur anpassen, wenn Host-RAM/Policy abweichen.
# NEO4J_IMAGE=neo4j:5.26-community
# NEO4J_HEAP_INITIAL=512m
# NEO4J_HEAP_MAX=2g
# NEO4J_PAGECACHE_SIZE=4g

# ===== Embedding Configuration =====
# Aktuell empfohlener Pfad: Qwen3 Embeddings (2560 Dimensionen)
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_BASE_URL=http://localhost:11434
VECTOR_DIM=2560

# Fallback für kleinere / ältere Setups:
# EMBEDDING_MODEL=nomic-embed-text
# VECTOR_DIM=768

# Agora validiert das Embedding beim Start mit einer echten Probe.
# Wenn EMBEDDING_MODEL / VECTOR_DIM nicht zusammenpassen, startet das Backend nicht.
# For Docker with host Ollama: EMBEDDING_BASE_URL=http://host.docker.internal:11434

# OpenAI-Embeddings als Cloud-Alternative (Local-first bleibt Default).
# EMBEDDING_BASE_URL erkennt OpenAI-kompatible Endpoints automatisch und
# schaltet auf Bearer-Auth um. Achtung: Provider-Wechsel braucht einen
# Vector-Index-Rebuild in Neo4j (siehe docu/embedding-provider-switch.md).
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
# VECTOR_DIM=1536
# Andere bekannte OpenAI-Embedding-Modelle:
#   text-embedding-3-large → VECTOR_DIM=3072
#   text-embedding-ada-002 → VECTOR_DIM=1536

# ===== Ontology Generation =====
# Entitätstypen sind nicht mehr auf die alte Zep-Grenze von exakt 10 fixiert.
# Mehr Typen können bessere Rollenabdeckung liefern, erhöhen aber Rauschen und
# Überschneidungen in der Extraktion. Defaults: 8-16 Entity Types, max. 12 Edge Types.
# ONTOLOGY_MIN_ENTITY_TYPES=8
# ONTOLOGY_MAX_ENTITY_TYPES=16
# ONTOLOGY_MAX_EDGE_TYPES=12

# ===== Hybrid Search Weights =====
# SearchService kombiniert Vector-Score und BM25-Keyword-Score gewichtet.
# Defaults reproduzieren das alte Verhalten (0.7 / 0.3); per Graph
# tuneable, falls die Mischung in der Praxis daneben liegt. Die Werte
# müssen sich nicht zu 1.0 summieren — beide Seiten werden vor dem Mix
# normalisiert.
# HYBRID_SEARCH_VECTOR_WEIGHT=0.7
# HYBRID_SEARCH_KEYWORD_WEIGHT=0.3

# ===== Agent Tool-Use during Simulation =====
# Experimental and opt-in. When enabled, simulation agents can query
# the knowledge graph before deciding actions. This is slower and adds LLM calls.
# ENABLE_AGENT_TOOLS=false
# MAX_TOOL_CALLS_PER_ACTION=2

# ===== Event Bus (Issue #9 Phase B) =====
# Transport für die Flask↔OASIS-Subprozess-IPC (Pause/Resume/Interview/State).
# `auto` (Default) probiert Redis und fällt auf File-Polling zurück, falls
# REDIS_URL nicht erreichbar ist. `redis` erzwingt Redis (Startup-Fail wenn down).
# `file` behält das Pre-Issue-9-Verhalten (reiner File-Poll-Loop).
# EVENT_BUS_BACKEND=auto
REDIS_URL=redis://redis:6379/0

# ===== Logging =====
# `text` = menschenlesbar, `json` = strukturierte Logs für zentrale Auswertung.
# AGORA_LOG_FORMAT=text

# ===== Time / Locale Profile =====
# Default: German/DACH social activity profile (Europe/Berlin).
TIME_PROFILE=dach_default
AGENT_LANGUAGE=de
REPORT_LANGUAGE=German

# ===== Optional Webtools for ReportAgent =====
# ENABLE_WEB_TOOLS=true
# TAVILY_API_KEY=your-key-here

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Points to same local Ollama server
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Docker-mode overrides =====
# Uncomment these when using Docker Compose with host Ollama
# (backend container talks to Neo4j by service name and host Ollama via extra_hosts)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_BASE_URL=http://host.docker.internal:11434/v1

# === Persona-Generation Performance (Issue #217 Stufe 2a) ===
# Anzahl paralleler LLM-Roundtrips bei Persona-Generation.
# Cloud-LLM (Ollama-Bridge gegen gemini-3-flash, qwen3-coder-next:cloud,
# deepseek-v3.2:cloud usw.): 10-15 ist sicher.
# Lokal (Ollama mit qwen2.5:14b / llama3.1:8b): 3-5 empfohlen,
# sonst KV-Cache-Trashing bei parallelen Anfragen.
# Default wenn nicht gesetzt: 10
# AGORA_PARALLEL_PERSONA_COUNT=10

# Ollama-Optimierungen fuer Cloud-Modelle (via Ollama-Bridge):
# Bei Cloud-Modellen mit nativer Tool-Use-Pipeline ist OpenAI-JSON-Mode
# oft langsamer als free-form-JSON mit Repair. Bei Reasoning-Models
# (gemini-3-flash, qwen3-coder) erzeugt "thinking"-Output einen
# zusaetzlichen Roundtrip-Block. Beide Flags auf false setzen fuer
# maximale Durchsatz-Optimierung.
# LLM_DISABLE_JSON_MODE=true
# OLLAMA_THINKING=false

# Max-Output-Tokens fuer Sim-Runner (run_reddit_simulation / run_twitter_simulation).
# Default seit 2026-05-16: 16384. Verhindert silent OOM/Truncation bei
# Multi-Agent-Workloads mit grossem num_ctx (CAMEL-Issue). Auf 8192 oder
# kleiner setzen, wenn LLM-Provider strikte Output-Limits hat.
# LLM_MAX_OUTPUT_TOKENS=16384

# Persona-Detail-Level (Issue #217 Stufe 2b) — steuert Output-Groesse pro Persona.
# Direkter Hebel auf Cloud-LLM-Inference-Zeit:
# - compact:  300-500 Woerter, ~3x schneller als rich, knapper Stil (gut fuer Bulk-Sims)
# - standard: 700-900 Woerter, Default — Balance zwischen Detail und Tempo
# - rich:     1500-2000 Woerter, alter Stand vor #217 Stufe 2b (hoechste Reichhaltigkeit)
AGORA_PERSONA_DETAIL_LEVEL=standard

# --- Observability (Slice 1) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agora-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Observability Metrics (Slice 2a) ---
# Aktiviert MeterProvider + OTLP-gRPC-Exporter für Lauf-/Bus-/LLM-Metrics.
# Default: false — kein Overhead und keine Netzwerkverbindung zum Collector.
OTEL_METRICS_ENABLED=false
# Export-Intervall in Millisekunden (Default: 10000 = 10 Sekunden).
# OTEL_METRIC_EXPORT_INTERVAL=10000

# --- Observability Logs (Slice 3a) ---
# Aktiviert LoggerProvider + LoggingInstrumentor: injiziert trace_id/span_id
# in jeden Python-LogRecord und gibt JSON-Zeilen auf stdout aus.
# Default: false — kein Overhead und keine Netzwerkverbindung zum Collector.
OTEL_LOGS_ENABLED=false

# --- Observability Frontend (Slice 1e) ---
# Aktiviert den Browser-OTel-Tracer (WebTracerProvider + OTLP-HTTP).
# Default: false — kein Overhead und keine Netzwerkverbindung zum Collector.
# VITE_OTEL_ENABLED=false
# OTLP-HTTP-Collector-Endpunkt (muss /v1/traces enthalten, kein gRPC im Browser).
# VITE_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# SigNoz-UI-Basis-URL für Deep-Links im SimDetail-Panel.
# VITE_SIGNOZ_UI=http://localhost:3301

