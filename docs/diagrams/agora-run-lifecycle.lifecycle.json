  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Hauptpfad",
      "items": [
        "RunLifecycle legt jeden Run mit status pending an und schreibt beim Verlassen des Kontexts einen Endzustand",
        "Simulation und Reportlauf tragen beide den kanonischen Status processing — der Unterschied steckt in der Phase, nicht im Statuswert",
        "Nur completed, failed und stopped setzen completed_at"
      ]
    },
    {
      "dot": "amber",
      "title": "Unterbrechung",
      "items": [
        "Paused haelt die Simulationsrunden an, ohne den Run zu beenden",
        "Der Uebergang zurueck aus Paused fuehrt in denselben processing-Zustand, nicht in einen neuen Run",
        "Ein pausierter Run zaehlt in der Registry weiterhin als offen"
      ]
    },
    {
      "dot": "rose",
      "title": "Ausgaenge",
      "items": [
        "Failed ist wiederaufnehmbar: der Reportlauf setzt auf bereits persistierten Abschnitten auf",
        "Stopped ist ein Nutzerabbruch und zeigt nicht zurueck in die Ausfuehrung",
        "run_registry.canonical_status bildet Fremdwerte wie ready oder idle auf diese Menge ab"
      ]
    }
  ]
}
