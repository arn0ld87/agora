    {
      "id": "panel-sim-throughput",
      "title": "Sim Throughput",
      "description": "Rate of simulations started, grouped by terminal status (running/completed/failed).",
      "panelTypes": "graph",
      "yAxisUnit": "cps",
      "nullZeroValues": "zero",
      "opacity": "1",
      "isStacked": false,
      "timePreferance": "GLOBAL_TIME",
      "softMin": 0,
      "softMax": null,
      "query": {
        "queryType": "builder",
        "promql": [],
        "clickhouse_sql": [],
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "metrics",
              "aggregateOperator": "rate",
              "aggregateAttribute": {
                "key": "agora.sim.started",
                "dataType": "float64",
                "type": "Sum",
                "isColumn": true,
                "isJSON": false
              },
              "timeAggregation": "rate",
              "spaceAggregation": "sum",
              "functions": [],
              "filters": { "items": [], "op": "AND" },
              "groupBy": [
                { "key": "status", "dataType": "string", "type": "tag", "isColumn": false, "isJSON": false }
              ],
              "legend": "{{status}}",
              "disabled": false,
              "having": [],
              "stepInterval": 60,
              "limit": null,
              "orderBy": [],
              "reduceTo": "avg"
            }
          ]
        }
      }
    },
