{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "MultiEdit(**)",
      "Glob(**)",
      "Grep(**)",
      "LS(**)",
      "Think(**)",
      "TodoWrite(**)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__code-review-graph__*",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__plugin_serena_serena__*",
      "mcp__plugin_honcho_honcho__*",
      "mcp__docfork__*",
      "Skill(**)",
      "Agent(*)",
      "Task(*)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh workflow run*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr close*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh run download*)",
      "Bash(gh release view*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh api*)",
      "Bash(code-review-graph *)",
      "Bash(uvx code-review-graph *)",
      "Bash(context-mode doctor*)",
      "Bash(context-mode *)",
      "Bash(cd backend && uv run pytest tests/contracts/ -x -q*)",
      "Bash(cd backend && uv run python -m app.contracts.dump_schemas*)",
      "Bash(cd backend && uv run ruff check*)",
      "Bash(cd backend && uv run mypy app*)",
      "Bash(cd frontend && npm run check*)",
      "Bash(cd frontend && npm test*)",
      "Bash(npm run check*)",
      "Bash(npm run setup:all*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv export*)",
      "Bash(uv tree*)",
      "Bash(uv run pytest*)",
      "Bash(uv run python*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(pip-audit*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(docker compose down*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; case \"$FILE\" in *.py) cd backend 2>/dev/null && uv run ruff check --fix \"$FILE\" 2>&1 | head -10 ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); STOP=$(echo \"$INPUT\" | jq -r '.stop_hook_active // false'); if [ \"$STOP\" = \"true\" ]; then exit 0; fi; cd backend && uv run pytest tests/contracts/ -x -q 2>&1 | tail -10; exit 0"
          }
        ]
      }
    ]
  }
}
