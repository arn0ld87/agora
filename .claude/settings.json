          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); STOP=$(echo \"$INPUT\" | jq -r '.stop_hook_active // false'); if [ \"$STOP\" = \"true\" ]; then exit 0; fi; cd backend && uv run pytest tests/contracts/ -x -q 2>&1 | tail -10; exit 0"
          }
        ]
      }
    ]
