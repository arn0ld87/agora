{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(docker *)",
      "Bash(nala *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(bash scripts/*)",
      "Bash(curl *)",
      "Bash(clawpatch *)",
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Glob(**)",
      "LS(**)",
      "Think(**)",
      "WebFetch(domain:*)",
      "mcp__*",
      "Skill(**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*secret*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/credentials*)",
      "Write(**/*secret*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/credentials*)",
      "Edit(**/*secret*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(> *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(git push *)",
      "Bash(git push --force*)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(ssh *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; case \"$FILE\" in *.py) cd backend 2>/dev/null && uv run ruff check --fix \"$FILE\" 2>&1 | head -10 ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); STOP=$(echo \"$INPUT\" | jq -r '.stop_hook_active // false'); if [ \"$STOP\" = \"true\" ]; then exit 0; fi; cd backend && uv run pytest tests/contracts/ -x -q 2>&1 | tail -10; exit 0"
          }
        ]
      }
    ]
  }
}
