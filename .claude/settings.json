{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "MultiEdit(**)",
      "Glob(**)",
      "Grep(**)",
      "LS(**)",
      "Think(**)",
      "TodoWrite(**)",
      "WebSearch",
      "WebFetch(domain:*)",
      "Skill(**)",
      "Agent(*)",
      "Task(*)",
      "mcp__code-review-graph__*",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__plugin_serena_serena__*",
      "mcp__plugin_honcho_honcho__*",
      "mcp__plugin_lovable_lovable__*",
      "mcp__docfork__*",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip-audit *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(code-review-graph *)",
      "Bash(coderabbit *)",
      "Bash(context-mode *)",
      "Bash(shellcheck *)",
      "Bash(bash scripts/*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git restore*)",
      "Bash(git revert*)",
      "Bash(git rm*)",
      "Bash(docker compose down*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(bash scripts/e2e-down.sh*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*.json)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; case \"$FILE\" in *.py) cd backend 2>/dev/null && uv run ruff check --fix \"$FILE\" 2>&1 | head -10 ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); STOP=$(echo \"$INPUT\" | jq -r '.stop_hook_active // false'); if [ \"$STOP\" = \"true\" ]; then exit 0; fi; cd backend && uv run pytest tests/contracts/ -x -q 2>&1 | tail -10; exit 0"
          }
        ]
      }
    ]
  }
}
