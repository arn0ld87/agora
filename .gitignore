__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.eggs/
*.egg-info/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Tests
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
frontend/coverage/
frontend/lcov.info

# Agent tooling
.cursor/
.codex/
.serena/

# Claude Code per-project setup: agents + slash-commands + permissions tracken,
# aber lokale Per-User-Settings, geschachtelte Worktrees und Sessions raushalten.
.claude/settings.local.json
.claude/worktrees/
.claude/projects/
.claude/scheduled_tasks.lock

# Local docs and scratch dirs
mydoc/
mytest/
errors/
.alex-eastereggs.local.md
context.md
# Lokale Blog-/Test-Dokumente am Repo-Root (User-Content, Pipeline-Fixtures)
/blog-*-draft.md
/test-document*.md

# docu/ ist seit v0.8.0 öffentlich (Portfolio-Material).
# AGENTS.md / CLAUDE.md / PLAN.md / REFACTORING_PLAN.md / SECURITY_REVIEW.md
# sind seit Sub-Slice 34 ebenfalls getrackt — Onboarding-/Plan-Material, das
# externe Mitarbeiter und kollaborierende Agenten (Claude, Codex, Gemini)
# vor dem ersten Edit lesen können müssen.
PLAN.md.bak
# .github/ enthält die CI- und Docker-Image-Workflows — getrackt und aktiv.
# docs/ ist getrackt (öffentliche Sachdokus, ADRs, runbooks).
# docs/.local/ ist Ablage für interne Worklogs/Pläne/Archive — bleibt lokal:
/docs/.local/
/Agora_design/
/scripts/logs/
/.codex
# ``/.gitleaksignore`` ist tracked — offizielle gitleaks-Allowlist für
# dokumentierte Test-Fixtures (siehe Header der Datei). Niemals echte
# Secrets eintragen; jeder Eintrag muss als belegtes Test-Fixture im
# Commit-Body begründet sein.
# /media/: Default ignored, aber README-relevante Assets (logo, screenshots, credits) re-included.
# WICHTIG: /media/* statt /media/ — bei Verzeichnis-Match kann man Kinder nicht re-includen.
/media/*
!/media/agora-logo.*
!/media/agora-logo-animated.svg
!/media/screenshots/
!/media/credits/
/static/image/
/static/media/

# Log files
backend/logs/
*.log

# Archives / Snapshots (kein Backup im Repo)
*.zip

# Playwright-MCP test artefacts (Konsolenlogs, Page-Snapshots)
.playwright-mcp/

# CI-Trace-Artefakte (Failure-Snapshots, error-context.md, trace.zip)
# Lokal hilfreich zum Debuggen, aber nie einchecken.
.ci-trace/

# Persistent caches mounted into the agora container
backend/.cache/

# Runtime artifacts and local instances
/instance/
# Flask instance path with local run data, LLM traces, routing snapshots,
# user uploads metadata, SQLite state, and other private runtime artifacts.
backend/instance/

# Upload folder
backend/uploads/

# Multi-Provider-Hub (Issue #450 P1.3): laufzeitbeschriebene Daten in
# backend/data/ enthalten Fernet-Ciphertexte (Provider-Keys) und
# Workspace-Routing-Defaults. Sie dürfen nicht ins Repo. Die .gitkeep im
# Verzeichnis bleibt getrackt, damit der Pfad existiert.
backend/data/*
!backend/data/.gitkeep

# Docker data
data/backend/venv311/
backend/venv311/
.fehler/konsole_safari
backend/instance/*.db

# code-review-graph local storage (Tree-sitter graph cache, embeddings)
.code-review-graph/

# clawpatch local state (findings, features, runs, locks, reports)
.clawpatch/

# Ad-hoc Smoke- / Seed-Helper, die nur lokal entstehen (dump-Skripte,
# Screenshot-Drops, persönliche Test-Seed-Dokumente).
.tmp-*
test-seed-*.md

# graphify Knowledge-Graph-Output (lokaler Build-Artefakt-Cache)
graphify-out/

# open-mem lokaler Memory-Store (SQLite inkl. WAL/SHM, nur maschinenlokal)
.open-mem/

# Zeitgestempelte Backup-Kopien, die Tools beim Umschreiben von Configs anlegen
# (z. B. opencode.jsonc.bak.20260720-080351).
*.bak.[0-9]*

# Lokale Opencode-Konfiguration (persoenliches Setup, nicht repo-weit gueltig)
opencode.jsonc

# Claude Code: lokale, maschinenspezifische Freigaben
.claude/settings.local.json
.claude/settings.local.json.bak
.claude/settings.local.json.bak.*

.claude/*.bak
.claude/*.bak.*
compose.local.yml
