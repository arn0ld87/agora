{
  "$defs": {
    "BudgetWarning": {
      "additionalProperties": false,
      "description": "Auditierbare Warnung bei (weicher oder harter) Limit\u00fcberschreitung.",
      "properties": {
        "dimension": {
          "enum": [
            "tokens",
            "cost",
            "time",
            "calls"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "minimum": 0,
          "title": "Observed",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "soft",
            "hard"
          ],
          "title": "Severity",
          "type": "string"
        },
        "threshold": {
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "severity",
        "threshold",
        "observed",
        "message",
        "ts"
      ],
      "title": "BudgetWarning",
      "type": "object"
    },
    "RunBudgetConfig": {
      "additionalProperties": false,
      "description": "Vom Nutzer gesetzte Budget-Limits f\u00fcr einen Run.\n\nAlle Limits optional; None bedeutet \u201ekein Limit\u201c. `enforcement` gilt\nf\u00fcr alle gesetzten Limits gemeinsam: soft = warnen und weiterlaufen,\nhard = weitere planbare Modellaufrufe deterministisch verhindern.",
      "properties": {
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "enforcement": {
          "default": "soft",
          "enum": [
            "soft",
            "hard"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "max_cost_micros": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Micros"
        },
        "max_duration_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration Seconds"
        },
        "max_llm_calls": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Llm Calls"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "RunBudgetConfig",
      "type": "object"
    },
    "UsageMetrics": {
      "additionalProperties": false,
      "description": "Gemessener Verbrauch eines Runs oder einer Teilmenge (Stage/Provider/Modell).\n\nOptionale Felder bleiben None, wenn die Datenquelle sie nicht liefert \u2014\nder jeweilige Status macht die Datenqualit\u00e4t explizit.",
      "properties": {
        "cost_micros": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Micros"
        },
        "cost_status": {
          "default": "unknown",
          "enum": [
            "measured",
            "estimated",
            "free",
            "unknown"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "tokens_status": {
          "default": "unknown",
          "enum": [
            "measured",
            "partial",
            "unknown"
          ],
          "title": "Tokens Status",
          "type": "string"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "UsageMetrics",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/run-budget-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aktueller Budget-Zustand eines Runs: Config + Verbrauch + Warnungen.",
  "properties": {
    "config": {
      "$ref": "#/$defs/RunBudgetConfig"
    },
    "consumed": {
      "$ref": "#/$defs/UsageMetrics"
    },
    "exceeded_dimension": {
      "anyOf": [
        {
          "enum": [
            "tokens",
            "cost",
            "time",
            "calls"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exceeded Dimension"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "warning",
        "exceeded"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/BudgetWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "config",
    "consumed"
  ],
  "title": "RunBudgetStatus",
  "type": "object"
}
