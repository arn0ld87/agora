{
  "$defs": {
    "ClassifiedContribution": {
      "additionalProperties": false,
      "description": "Ein Simulationsbeitrag mit seiner klassifizierten Haltung.",
      "properties": {
        "action_type": {
          "title": "Action Type",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "integer"
        },
        "agent_name": {
          "title": "Agent Name",
          "type": "string"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "producer_key": {
          "title": "Producer Key",
          "type": "string"
        },
        "round_num": {
          "title": "Round Num",
          "type": "integer"
        },
        "stance_class": {
          "enum": [
            "in_favour",
            "opposed",
            "undecided"
          ],
          "title": "Stance Class",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "agent_name",
        "platform",
        "round_num",
        "action_type",
        "producer_key",
        "stance_class"
      ],
      "title": "ClassifiedContribution",
      "type": "object"
    },
    "VoiceStance": {
      "additionalProperties": false,
      "description": "Haltung einer Stimme: Startwert, Beitr\u00e4ge und Interview.",
      "properties": {
        "agent_name": {
          "title": "Agent Name",
          "type": "string"
        },
        "contribution_classes": {
          "items": {
            "enum": [
              "in_favour",
              "opposed",
              "undecided"
            ],
            "type": "string"
          },
          "title": "Contribution Classes",
          "type": "array"
        },
        "interview_class": {
          "anyOf": [
            {
              "enum": [
                "in_favour",
                "opposed",
                "undecided"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interview Class"
        },
        "role_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Family"
        },
        "start_class": {
          "enum": [
            "in_favour",
            "opposed",
            "undecided"
          ],
          "title": "Start Class",
          "type": "string"
        },
        "voice_key": {
          "title": "Voice Key",
          "type": "string"
        }
      },
      "required": [
        "voice_key",
        "agent_name",
        "start_class"
      ],
      "title": "VoiceStance",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/stance-analysis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Positionierungsquote und Lagerverteilung eines Laufs.",
  "properties": {
    "applicable": {
      "title": "Applicable",
      "type": "boolean"
    },
    "camp_distribution": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "in_favour",
          "opposed",
          "undecided"
        ]
      },
      "title": "Camp Distribution",
      "type": "object"
    },
    "classification_failed": {
      "default": 0,
      "minimum": 0,
      "title": "Classification Failed",
      "type": "integer"
    },
    "classified_total": {
      "default": 0,
      "minimum": 0,
      "title": "Classified Total",
      "type": "integer"
    },
    "contested_statement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contested Statement"
    },
    "contributions": {
      "items": {
        "$ref": "#/$defs/ClassifiedContribution"
      },
      "title": "Contributions",
      "type": "array"
    },
    "positioning_ratio": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Positioning Ratio"
    },
    "voices": {
      "items": {
        "$ref": "#/$defs/VoiceStance"
      },
      "title": "Voices",
      "type": "array"
    },
    "voices_positioned": {
      "default": 0,
      "minimum": 0,
      "title": "Voices Positioned",
      "type": "integer"
    },
    "voices_total": {
      "default": 0,
      "minimum": 0,
      "title": "Voices Total",
      "type": "integer"
    }
  },
  "required": [
    "applicable"
  ],
  "title": "StanceAnalysis",
  "type": "object"
}
