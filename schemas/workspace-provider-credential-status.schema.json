{
  "$id": "https://alexle135.de/schemas/workspace-provider-credential-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configured": {
      "title": "Configured",
      "type": "boolean"
    },
    "provider_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "provider_id",
    "configured"
  ],
  "title": "WorkspaceProviderCredentialStatus",
  "type": "object"
}
