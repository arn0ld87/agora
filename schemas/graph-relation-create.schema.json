{
  "$id": "https://alexle135.de/schemas/graph-relation-create.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Beziehung von Hand anlegen (ohne Episoden, damit ohne Dokumentanker).",
  "properties": {
    "client_request_id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "Client Request Id",
      "type": "string"
    },
    "fact": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Fact",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "source_uuid": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "Source Uuid",
      "type": "string"
    },
    "target_uuid": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "Target Uuid",
      "type": "string"
    }
  },
  "required": [
    "client_request_id",
    "source_uuid",
    "target_uuid",
    "name",
    "fact"
  ],
  "title": "RelationCreate",
  "type": "object"
}
