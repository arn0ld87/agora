{
  "$defs": {
    "AgentLogRef": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "section_index": {
          "minimum": 0,
          "title": "Section Index",
          "type": "integer"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        }
      },
      "required": [
        "section_index",
        "action"
      ],
      "title": "AgentLogRef",
      "type": "object"
    },
    "ConfidenceLabel": {
      "enum": [
        "low",
        "medium",
        "high",
        "verified"
      ],
      "title": "ConfidenceLabel",
      "type": "string"
    },
    "EntailmentVerdict": {
      "description": "Urteil der zweiten Binding-Stufe.\n\nSpiegelt ``app.services.evidence_entailment.EntailmentVerdict``. Nur\n``SUPPORTED`` rechtfertigt ``supports_claim=True``; ``RELATED_ONLY`` und\n``INSUFFICIENT`` erh\u00f6hen die Confidence nie.",
      "enum": [
        "SUPPORTED",
        "CONTRADICTED",
        "RELATED_ONLY",
        "INSUFFICIENT"
      ],
      "title": "EntailmentVerdict",
      "type": "string"
    },
    "EvidenceDegradationModel": {
      "additionalProperties": false,
      "description": "Maschinenlesbares Protokoll einer lokalen Claim-Degradierung (Issue #1006).\n\nEin einzelner ADR-0002-Verstoss kippte bisher den gesamten Report auf\nFAILED und vernichtete bereits fertige Sections. Statt den Validator zu\nlockern, wird der verletzende Claim lokal abgestuft und die Reparatur\nhier protokolliert.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "section_index": {
          "title": "Section Index",
          "type": "integer"
        },
        "violation": {
          "title": "Violation",
          "type": "string"
        }
      },
      "required": [
        "section_index",
        "claim_id",
        "violation",
        "action",
        "detail"
      ],
      "title": "EvidenceDegradationModel",
      "type": "object"
    },
    "EvidenceItemModel": {
      "additionalProperties": false,
      "description": "Bestehende EvidenceItem-Felder aus report_agent.py, jetzt typsicher.",
      "properties": {
        "agent_log_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentLogRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contradicts_claim": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contradicts Claim"
        },
        "entailment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntailmentVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entailment_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entailment Reason"
        },
        "match_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Score"
        },
        "persona_stakeholder_group": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Stakeholder Group"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "raw": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "retrieval_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Score"
        },
        "sentiment_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sentiment des Quellen-Snippets (-1 negativ, 0 neutral, +1 positiv).",
          "title": "Sentiment Score"
        },
        "snippet": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Snippet",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_id_anchor": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id Anchor"
        },
        "source_kind": {
          "$ref": "#/$defs/EvidenceSourceKind",
          "default": "inferred"
        },
        "source_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider+Modell, das diese Evidence-Zeile extrahiert hat (Slice 8).",
          "title": "Source Model"
        },
        "supports_claim": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supports Claim"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "type",
        "source",
        "snippet"
      ],
      "title": "EvidenceItemModel",
      "type": "object"
    },
    "EvidenceMapModel": {
      "additionalProperties": false,
      "description": "Persistierte Evidence-Map. Abl\u00f6se f\u00fcr die rohen Dicts in report_agent.py.",
      "properties": {
        "degradation_log": {
          "items": {
            "$ref": "#/$defs/EvidenceDegradationModel"
          },
          "title": "Degradation Log",
          "type": "array"
        },
        "global_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItemModel"
          },
          "title": "Global Evidence",
          "type": "array"
        },
        "report_id": {
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/ReportSectionModel"
          },
          "title": "Sections",
          "type": "array"
        },
        "simulation_id": {
          "minLength": 1,
          "title": "Simulation Id",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "simulation_id"
      ],
      "title": "EvidenceMapModel",
      "type": "object"
    },
    "EvidenceSourceKind": {
      "description": "ADR-0002 Anker 3 \u2014 Quellengattung pro Evidence-Item.\n\nWird von den Cross-Stakeholder-/Inferred-Validators auf\n``ReportClaimModel`` ausgewertet (Sub-Slice M11.7b, Anker 4 + 5).\nDrift-Guard: Diese Werte sind im Prompt-Block\n``backend/app/services/report_prompts/sections.py`` referenziert (Anker 1).\n\nErweiterung (Report-Trust-Slice): ``agent_action`` und ``web_source``\nerg\u00e4nzen die urspr\u00fcnglichen vier Werte. Das ist additiv und versch\u00e4rft\nADR-0002, statt es zu schw\u00e4chen \u2014 vorher liefen Agentenaktionen und\nWeb-Treffer \u00fcber den Default ``seed_corpus`` und verschmolzen damit\nSeed-Dokument, Simulation und Recherche zu einer einzigen Quellengattung.\nF\u00fcr die Confidence-Anker gilt weiterhin: nur ``agent_quote`` z\u00e4hlt als\nStakeholder-Stimme, nur ``seed_corpus`` als Dokumentfakt.",
      "enum": [
        "seed_corpus",
        "agent_quote",
        "agent_action",
        "graph_relation",
        "web_source",
        "inferred"
      ],
      "title": "EvidenceSourceKind",
      "type": "string"
    },
    "EvidenceType": {
      "description": "\u00dcbernommen aus report_agent.py \u2014 bestehende Typen plus model_generated_inference.",
      "enum": [
        "graph_fact",
        "graph_metric",
        "graph_metric_status",
        "relationship_chain",
        "entity_summary",
        "agent_action",
        "agent_interview",
        "web_search_result",
        "web_fetch",
        "model_generated_inference"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ReportClaimModel": {
      "additionalProperties": false,
      "properties": {
        "audit_trail": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Audit Trail",
          "type": "array"
        },
        "claim_id": {
          "pattern": "^claim_\\d{2,}$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "minLength": 8,
          "title": "Claim Text",
          "type": "string"
        },
        "confidence_label": {
          "$ref": "#/$defs/ConfidenceLabel"
        },
        "confidence_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItemModel"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "confidence_label",
        "confidence_score"
      ],
      "title": "ReportClaimModel",
      "type": "object"
    },
    "ReportModel": {
      "additionalProperties": false,
      "description": "Spiegelt models/report.py:Report \u2014 aber als Pydantic mit Validierung.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "evidence_sections": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Sections",
          "type": "integer"
        },
        "graph_id": {
          "minLength": 1,
          "title": "Graph Id",
          "type": "string"
        },
        "has_evidence": {
          "default": false,
          "title": "Has Evidence",
          "type": "boolean"
        },
        "markdown_content": {
          "default": "",
          "title": "Markdown Content",
          "type": "string"
        },
        "missing_sections": {
          "items": {
            "type": "string"
          },
          "title": "Missing Sections",
          "type": "array"
        },
        "outline": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportOutlineModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "red_team_findings": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Red Team Findings",
          "type": "array"
        },
        "report_id": {
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "simulation_id": {
          "minLength": 1,
          "title": "Simulation Id",
          "type": "string"
        },
        "simulation_requirement": {
          "minLength": 1,
          "title": "Simulation Requirement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        }
      },
      "required": [
        "report_id",
        "simulation_id",
        "graph_id",
        "simulation_requirement",
        "status"
      ],
      "title": "ReportModel",
      "type": "object"
    },
    "ReportOutlineModel": {
      "additionalProperties": false,
      "properties": {
        "sections": {
          "items": {
            "$ref": "#/$defs/ReportOutlineSectionModel"
          },
          "maxItems": 15,
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "sections"
      ],
      "title": "ReportOutlineModel",
      "type": "object"
    },
    "ReportOutlineSectionModel": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "ReportOutlineSectionModel",
      "type": "object"
    },
    "ReportSectionDataGapModel": {
      "additionalProperties": false,
      "description": "P2.1: Maschinenlesbare Luecke fuer nicht belegbare Claim-Kandidaten.",
      "properties": {
        "claim_text": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Claim Text",
          "type": "string"
        },
        "gap_id": {
          "pattern": "^gap_\\d{2,}$",
          "title": "Gap Id",
          "type": "string"
        },
        "gap_reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Gap Reason",
          "type": "string"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Fix"
        }
      },
      "required": [
        "gap_id",
        "claim_text",
        "gap_reason"
      ],
      "title": "ReportSectionDataGapModel",
      "type": "object"
    },
    "ReportSectionHypothesisModel": {
      "additionalProperties": false,
      "description": "ADR-0002 hypothesis slot \u2014 reasoning without evidence, not a claim.\n\nHypothesen duerfen nicht in ``claims[]`` formuliert werden, weil sie keine\nEvidence tragen. Dieses DTO macht den separaten Slot maschinenlesbar, ohne\ndie bestehenden Claim-/Evidence-Validatoren zu schwaechen.",
      "properties": {
        "hypothesis_id": {
          "pattern": "^hypothesis_\\d{2,}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "hypothesis_text": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Hypothesis Text",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Rationale",
          "type": "string"
        },
        "suggested_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Suggested Evidence",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "hypothesis_text",
        "rationale"
      ],
      "title": "ReportSectionHypothesisModel",
      "type": "object"
    },
    "ReportSectionModel": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ReportClaimModel"
          },
          "title": "Claims",
          "type": "array"
        },
        "data_gaps": {
          "items": {
            "$ref": "#/$defs/ReportSectionDataGapModel"
          },
          "title": "Data Gaps",
          "type": "array"
        },
        "generation_failed": {
          "default": false,
          "title": "Generation Failed",
          "type": "boolean"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/ReportSectionHypothesisModel"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "hypotheses_appendix": {
          "items": {
            "$ref": "#/$defs/ReportSectionHypothesisModel"
          },
          "maxItems": 50,
          "title": "Hypotheses Appendix",
          "type": "array"
        },
        "section_index": {
          "minimum": 1,
          "title": "Section Index",
          "type": "integer"
        },
        "section_summary": {
          "minLength": 1,
          "title": "Section Summary",
          "type": "string"
        },
        "section_title": {
          "minLength": 3,
          "title": "Section Title",
          "type": "string"
        },
        "structured_metadata": {
          "additionalProperties": true,
          "title": "Structured Metadata",
          "type": "object"
        }
      },
      "required": [
        "section_index",
        "section_title",
        "section_summary"
      ],
      "title": "ReportSectionModel",
      "type": "object"
    },
    "ReportStatus": {
      "description": "Spiegelt models/report.py:ReportStatus 1:1.",
      "enum": [
        "pending",
        "planning",
        "generating",
        "incomplete",
        "completed",
        "failed"
      ],
      "title": "ReportStatus",
      "type": "string"
    }
  },
  "$id": "https://alexle135.de/schemas/report-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Wurzel \u2014 was tats\u00e4chlich beim Export rausgeht.",
  "properties": {
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceMapModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/ReportModel"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "exported_at",
    "report"
  ],
  "title": "ReportContractModel",
  "type": "object"
}
