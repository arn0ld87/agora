    },
    "ReportSectionHypothesisModel": {
      "additionalProperties": false,
      "description": "ADR-0002 hypothesis slot \u2014 reasoning without evidence, not a claim.\n\nHypothesen duerfen nicht in ``claims[]`` formuliert werden, weil sie keine\nEvidence tragen. Dieses DTO macht den separaten Slot maschinenlesbar, ohne\ndie bestehenden Claim-/Evidence-Validatoren zu schwaechen.",
      "properties": {
        "hypothesis_id": {
          "pattern": "^hypothesis_\\d{2,}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "hypothesis_text": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Hypothesis Text",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Rationale",
          "type": "string"
        },
        "suggested_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Suggested Evidence",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "hypothesis_text",
        "rationale"
      ],
      "title": "ReportSectionHypothesisModel",
      "type": "object"
    },
    "ReportSectionModel": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/IndexedReportClaimModel"
          },
          "title": "Claims",
          "type": "array"
        },
        "data_gaps": {
          "items": {
            "$ref": "#/$defs/ReportSectionDataGapModel"
          },
          "title": "Data Gaps",
          "type": "array"
        },
        "generation_failed": {
          "default": false,
          "title": "Generation Failed",
          "type": "boolean"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/ReportSectionHypothesisModel"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "hypotheses_appendix": {
          "items": {
            "$ref": "#/$defs/ReportSectionHypothesisModel"
          },
          "maxItems": 50,
          "title": "Hypotheses Appendix",
          "type": "array"
        },
        "section_index": {
          "minimum": 1,
          "title": "Section Index",
          "type": "integer"
        },
        "section_summary": {
          "minLength": 1,
          "title": "Section Summary",
          "type": "string"
        },
        "section_title": {
          "minLength": 3,
          "title": "Section Title",
          "type": "string"
        },
        "structured_metadata": {
          "additionalProperties": true,
          "title": "Structured Metadata",
          "type": "object"
        },
        "unbound_evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Unbound Evidence Refs",
          "type": "array"
        },
        "unverified_statements": {
          "items": {
            "$ref": "#/$defs/ReportSectionUnverifiedStatementModel"
          },
          "maxItems": 200,
          "title": "Unverified Statements",
          "type": "array"
        }
      },
      "required": [
        "section_index",
        "section_title",
        "section_summary"
      ],
      "title": "ReportSectionModel",
      "type": "object"
    },
    "ReportSectionUnverifiedStatementModel": {
      "additionalProperties": false,
      "description": "Issue #1356: eine im Flie\u00dftext belassene, unbelegte Faktenaussage.\n\nBis #1356 wurde alles entfernt, was die Pr\u00fcfung nicht bestand \u2014 auch das,\nwas sie mangels passender Quelle nur nicht *entscheiden* konnte. Ein\nvollst\u00e4ndiger Referenzlauf verlor so 28 Aussagen, die weit \u00fcberwiegende\nMehrheit davon belegt. Seither bleibt der Satz stehen und tr\u00e4gt sichtbar\n``[Beleg fehlt]``; dieses Modell h\u00e4lt dieselbe Information maschinenlesbar,\ndamit Frontend und Audit nicht am Markerstring parsen m\u00fcssen.\n\nAbgrenzung zu ``ReportSectionHypothesisModel``: die Hypothese ist die\n*herausgel\u00f6ste* Behauptung samt Vorschlag, wie sie zu belegen w\u00e4re. Dieses\nModell beschreibt, was im gelesenen Text mit welcher Einschr\u00e4nkung\nstehengeblieben ist. Beide Slots werden bef\u00fcllt.",
      "properties": {
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "statement_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Statement Text",
          "type": "string"
        },
        "verdict": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "statement_text",
        "verdict",
        "reason"
      ],
      "title": "ReportSectionUnverifiedStatementModel",
      "type": "object"
    },
    "ReportStatus": {
      "description": "Spiegelt models/report.py:ReportStatus 1:1.",
      "enum": [
        "pending",
        "planning",
        "generating",
        "incomplete",
        "completed",
        "failed"
      ],
      "title": "ReportStatus",
      "type": "string"
    },
    "RunDegradationModel": {
      "additionalProperties": false,
      "description": "Ein Qualit\u00e4tsmangel des Report*laufs*, nicht eines einzelnen Claims.\n\nDer Referenzlauf ``report_cc2ef45da5e9`` ging als ``completed`` hinaus,\nobwohl die Simulation ``failed`` war, nur 45 von 48 Runden vorlagen und\nvon acht angeforderten Interviews keines zustande kam. Der\n``degradation_log`` blieb leer \u2014 er kennt nur Claim-Degradierungen, und\nf\u00fcr den Zustand des Laufs war schlicht niemand zust\u00e4ndig.\n\nAbgrenzung: ``EvidenceDegradationModel`` protokolliert die Abstufung eines\nClaims, ``PipelineDegradationModel`` den Ausfall eines Vorverarbeitungs-\nschritts. Dieses Modell steht dazwischen \u2014 es beschreibt, worauf der\nfertige Bericht beruht.",
      "properties": {
        "component": {
          "enum": [
            "simulation",
            "persona_generation",
            "interview_agents",
            "section_generation",
            "section_metadata",
            "requirement_checker",
            "contract_export"
          ],
          "title": "Component",
          "type": "string"
        },
        "detail": {
          "default": "",
          "description": "Menschenlesbare Erl\u00e4uterung.",
          "title": "Detail",
          "type": "string"
        },
        "reason": {
          "description": "Maschinenlesbarer Kurzgrund, z. B. '45_of_48_rounds'.",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "warning",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "component",
        "reason"
      ],
      "title": "RunDegradationModel",
      "type": "object"
    },
    "SimulationSnapshotModel": {
      "additionalProperties": false,
      "description": "Stand der Simulation zum Startzeitpunkt der Reportgenerierung (Issue #1192).\n\nEin Report darf starten, w\u00e4hrend die zugrunde liegende Simulation noch\nl\u00e4uft \u2014 dann analysiert er aber einen Zwischenstand. Ohne diesen Snapshot\nist einem fertigen Report nicht anzusehen, ob er auf zehn abgeschlossenen\nRunden beruht oder auf vieren. Erfasst wird der Stand *beim Start*, nicht\nbeim Abschluss: das ist der Datenbestand, den der Agent tats\u00e4chlich\ngesehen hat.",
      "properties": {
        "captured_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "rounds_completed": {
          "minimum": 0,
          "title": "Rounds Completed",
          "type": "integer"
        },
        "simulation_running": {
          "default": false,
          "title": "Simulation Running",
          "type": "boolean"
        },
        "simulation_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulation Status"
        },
        "total_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Total Rounds",
          "type": "integer"
        }
      },
      "required": [
        "rounds_completed"
      ],
      "title": "SimulationSnapshotModel",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/report-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Wurzel \u2014 was tats\u00e4chlich beim Export rausgeht.",
  "properties": {
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceMapModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_omitted": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceOmissionModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/ReportModel"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "exported_at",
    "report"
  ],
  "title": "ReportContractModel",
  "type": "object"
}
