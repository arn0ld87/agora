          "title": "Notes"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "confidence_label",
        "confidence_score"
      ],
      "title": "IndexedReportClaimModel",
      "type": "object"
    },
    "ReportSectionDataGapModel": {
      "additionalProperties": false,
      "description": "P2.1: Maschinenlesbare Luecke fuer nicht belegbare Claim-Kandidaten.",
