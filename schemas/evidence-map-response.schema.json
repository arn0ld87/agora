      },
      "required": [
        "gap_id",
        "claim_text",
        "gap_reason"
      ],
      "title": "ReportSectionDataGapModel",
      "type": "object"
    },
    "ReportSectionHypothesisModel": {
      "additionalProperties": false,
      "description": "ADR-0002 hypothesis slot \u2014 reasoning without evidence, not a claim.\n\nHypothesen duerfen nicht in ``claims[]`` formuliert werden, weil sie keine\nEvidence tragen. Dieses DTO macht den separaten Slot maschinenlesbar, ohne\ndie bestehenden Claim-/Evidence-Validatoren zu schwaechen.",
      "properties": {
        "hypothesis_id": {
          "pattern": "^hypothesis_\\d{2,}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "hypothesis_text": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Hypothesis Text",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Rationale",
          "type": "string"
        },
        "suggested_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Suggested Evidence",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "hypothesis_text",
        "rationale"
      ],
      "title": "ReportSectionHypothesisModel",
      "type": "object"
    },
    "ReportSectionModel": {
