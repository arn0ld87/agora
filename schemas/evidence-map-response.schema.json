        },
        "claim_id": {
          "pattern": "^claim_\\d{2,}$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "minLength": 8,
          "title": "Claim Text",
          "type": "string"
        },
        "confidence_label": {
          "$ref": "#/$defs/ConfidenceLabel"
        },
        "confidence_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ClaimEvidenceBindingModel"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
