{
  "$id": "https://alexle135.de/schemas/manifest-inputs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Eingangsdaten-Hashes und -Referenzen.\n\n``seed_document_hash``/``seed_document_filename`` sind ``Optional``\n(Issue #1274 Punkt 6): ist die Quelle eines Runs wirklich nicht\nermittelbar, ist ``None`` ehrlicher als der fr\u00fchere Platzhalter\n``\"unknown\"``, der wie ein echter Wert aussah.",
  "properties": {
    "embedding_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Version"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "graph_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Version"
    },
    "seed_document_filename": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed Document Filename"
    },
    "seed_document_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed Document Hash"
    },
    "simulation_config_hash": {
      "title": "Simulation Config Hash",
      "type": "string"
    }
  },
  "required": [
    "simulation_config_hash",
    "graph_id"
  ],
  "title": "ManifestInputs",
  "type": "object"
}
