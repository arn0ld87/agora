{
  "$id": "https://alexle135.de/schemas/llm-provider-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Metadata about an LLM provider (public, no secrets).",
  "properties": {
    "api_key_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Key Ref"
    },
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "fallback_models": {
      "items": {
        "type": "string"
      },
      "title": "Fallback Models",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "supports_models_endpoint": {
      "default": false,
      "title": "Supports Models Endpoint",
      "type": "boolean"
    },
    "supports_tools": {
      "default": false,
      "title": "Supports Tools",
      "type": "boolean"
    },
    "type": {
      "enum": [
        "ollama",
        "openai",
        "google",
        "anthropic",
        "custom",
        "ollama_cloud",
        "openai_compatible",
        "github_copilot",
        "cloud",
        "unknown"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "label",
    "type"
  ],
  "title": "ProviderDescriptor",
  "type": "object"
}
