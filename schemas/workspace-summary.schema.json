{
  "$defs": {
    "WorkspaceRole": {
      "description": "Rolle einer Mitgliedschaft. Werte identisch zum Check-Constraint\n``ck_workspace_members_role_valid``.",
      "enum": [
        "owner",
        "admin",
        "member",
        "viewer"
      ],
      "title": "WorkspaceRole",
      "type": "string"
    }
  },
  "$id": "https://alexle135.de/schemas/workspace-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ein Workspace aus Sicht eines Nutzers: mit seiner Rolle darin\n(``GET /api/workspaces``, #1616).",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/WorkspaceRole"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "name",
    "slug",
    "role"
  ],
  "title": "WorkspaceSummary",
  "type": "object"
}
