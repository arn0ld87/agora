{
  "$defs": {
    "AgentLogRef": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "section_index": {
          "minimum": 0,
          "title": "Section Index",
          "type": "integer"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        }
      },
      "required": [
        "section_index",
        "action"
      ],
      "title": "AgentLogRef",
      "type": "object"
    },
    "ChangeRecommendation": {
      "additionalProperties": false,
      "description": "Konkrete Handlungsempfehlung mit Priorit\u00e4t und Umsetzungsaufwand.",
      "properties": {
        "aufwand": {
          "enum": [
            "S",
            "M",
            "L"
          ],
          "title": "Aufwand",
          "type": "string"
        },
        "beschreibung": {
          "minLength": 1,
          "title": "Beschreibung",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        },
        "titel": {
          "minLength": 1,
          "title": "Titel",
          "type": "string"
        }
      },
      "required": [
        "id",
        "titel",
        "beschreibung",
        "priority",
        "aufwand"
      ],
      "title": "ChangeRecommendation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "Evidenz-gest\u00fctzter Befund aus der Szenarienanalyse.",
      "properties": {
        "aggregation_basis": {
          "enum": [
            "seed",
            "persona",
            "aggregat",
            "datenluecke"
          ],
          "title": "Aggregation Basis",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "speculative",
            "low",
            "medium",
            "high",
            "verified"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "confidence_scope": {
          "anyOf": [
            {
              "enum": [
                "simulation_consensus",
                "evidence",
                "empirical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Scope"
        },
        "evidence_refs": {
          "description": "Pflicht: mind. 1 Evidenz-Anker",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "persona_ids": {
          "items": {
            "type": "string"
          },
          "title": "Persona Ids",
          "type": "array"
        },
        "statement": {
          "minLength": 8,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence_refs",
        "confidence",
        "aggregation_basis"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ContentIdea": {
      "additionalProperties": false,
      "description": "Content-Idee mit Format-Empfehlung und Persona-Bezug.",
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "format": {
          "enum": [
            "blog",
            "video",
            "podcast",
            "social",
            "whitepaper",
            "webinar",
            "other"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "persona_ids": {
          "items": {
            "type": "string"
          },
          "title": "Persona Ids",
          "type": "array"
        },
        "titel": {
          "minLength": 1,
          "title": "Titel",
          "type": "string"
        }
      },
      "required": [
        "id",
        "titel",
        "format"
      ],
      "title": "ContentIdea",
      "type": "object"
    },
    "DataGap": {
      "additionalProperties": false,
      "description": "Datenl\u00fccke, die Einsch\u00e4tzungsqualit\u00e4t einschr\u00e4nkt.",
      "properties": {
        "beschreibung": {
          "minLength": 1,
          "title": "Beschreibung",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_fixes": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Fixes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "beschreibung",
        "severity"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "EvidenceRecordModel": {
      "additionalProperties": false,
      "description": "Claim-unabhaengiger, kanonisch adressierbarer Quellen-Datensatz.",
      "properties": {
        "agent_log_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentLogRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "pattern": "^ev_[0-9a-f]{32}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "persona_stakeholder_group": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Stakeholder Group"
        },
        "producer_key": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Producer Key",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "raw": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "sentiment_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": -1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentiment Score"
        },
        "snippet": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Snippet",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_id_anchor": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id Anchor"
        },
        "source_kind": {
          "$ref": "#/$defs/EvidenceSourceKind",
          "default": "inferred"
        },
        "source_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Model"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "evidence_id",
        "producer_key",
        "type",
        "source",
        "snippet"
      ],
      "title": "EvidenceRecordModel",
      "type": "object"
    },
    "EvidenceSourceKind": {
      "description": "ADR-0002 Anker 3 \u2014 Quellengattung pro Evidence-Item.\n\nWird von den Cross-Stakeholder-/Inferred-Validators auf\n``ReportClaimModel`` ausgewertet (Sub-Slice M11.7b, Anker 4 + 5).\nDrift-Guard: Diese Werte sind im Prompt-Block\n``backend/app/services/report_prompts/sections.py`` referenziert (Anker 1).\n\nErweiterung (Report-Trust-Slice): ``agent_action`` und ``web_source``\nerg\u00e4nzen die urspr\u00fcnglichen vier Werte. Das ist additiv und versch\u00e4rft\nADR-0002, statt es zu schw\u00e4chen \u2014 vorher liefen Agentenaktionen und\nWeb-Treffer \u00fcber den Default ``seed_corpus`` und verschmolzen damit\nSeed-Dokument, Simulation und Recherche zu einer einzigen Quellengattung.\nF\u00fcr die Confidence-Anker gilt weiterhin: nur ``agent_quote`` z\u00e4hlt als\nStakeholder-Stimme, nur ``seed_corpus`` als Dokumentfakt.",
      "enum": [
        "seed_corpus",
        "agent_quote",
        "agent_action",
        "graph_relation",
        "web_source",
        "inferred"
      ],
      "title": "EvidenceSourceKind",
      "type": "string"
    },
    "EvidenceType": {
      "description": "\u00dcbernommen aus report_agent.py \u2014 bestehende Typen plus model_generated_inference.",
      "enum": [
        "graph_fact",
        "graph_metric",
        "graph_metric_status",
        "relationship_chain",
        "entity_summary",
        "agent_action",
        "agent_interview",
        "web_search_result",
        "web_fetch",
        "seed_document",
        "model_generated_inference"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "FrictionPoint": {
      "additionalProperties": false,
      "description": "Hindernis oder Reibungspunkt, der Adoption oder Akzeptanz verringert.",
      "properties": {
        "affected_persona_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Persona Ids",
          "type": "array"
        },
        "beschreibung": {
          "minLength": 1,
          "title": "Beschreibung",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "id",
        "beschreibung",
        "severity"
      ],
      "title": "FrictionPoint",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "Hypothese ohne harte Evidence \u2014 separater Slot in ReportV3.\n\nAbgrenzung zu DataGap:\n- DataGap = strukturelle Datenl\u00fccke, die Einsch\u00e4tzungsqualit\u00e4t limitiert.\n- Hypothesis = inhaltliche Behauptung ohne Beleg, mit Rationale.",
      "properties": {
        "confidence_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "hypothesis_text": {
          "minLength": 1,
          "title": "Hypothesis Text",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "origin_section_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Section Index"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "suggested_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "hypothesis_text"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "ModelAttribution": {
      "additionalProperties": false,
      "description": "Welches LLM-Modell hat welche Pipeline-Stage produziert.\n\nSlice 8 (User-Bericht 2026-05-16): \"Es hinterlegt nirgendwo welches Modell\nf\u00fcr welchen Teil der Erstellung zust\u00e4ndig war.\" Pro abgeschlossener Stage\nein Eintrag \u2014 Frontend rendert sie als ausklappbare Provenance-Sektion.\nFelder absichtlich optional (au\u00dfer stage/provider/model_id), damit nicht\njeder Provider Tokens/Latency liefert.",
      "properties": {
        "completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Tokens"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model_id": {
          "description": "Backend-Modell-ID, z. B. 'qwen2.5:32b'",
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optionaler Hinweis (z. B. 'fallback nach timeout').",
          "title": "Note"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "provider": {
          "description": "z. B. 'ollama', 'openai', 'google'",
          "enum": [
            "ollama",
            "openai",
            "google",
            "anthropic",
            "custom",
            "ollama_cloud",
            "openai_compatible",
            "minimax",
            "opencode_go",
            "github_copilot",
            "cloud",
            "unknown"
          ],
          "title": "Provider",
          "type": "string"
        },
        "stage": {
          "enum": [
            "ontology",
            "graph_extraction",
            "simulation",
            "report_outline",
            "report_section",
            "report_synthesis",
            "red_team",
            "evidence_extraction",
            "interview",
            "other"
          ],
          "title": "Stage",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        }
      },
      "required": [
        "stage",
        "provider",
        "model_id"
      ],
      "title": "ModelAttribution",
      "type": "object"
    },
    "Multiplier": {
      "additionalProperties": false,
