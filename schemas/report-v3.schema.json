        "bildungsgrad": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bildungsgrad"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "haushaltseinkommen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
