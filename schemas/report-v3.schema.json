          "items": {
            "type": "string"
          },
          "title": "Affected Segments",
          "type": "array"
        },
        "beschreibung": {
          "minLength": 1,
          "title": "Beschreibung",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "speculative",
            "low",
            "medium",
            "high",
            "verified"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
