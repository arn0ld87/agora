{
  "$defs": {
    "ReportOutlineModel": {
      "additionalProperties": false,
      "properties": {
        "sections": {
          "items": {
            "$ref": "#/$defs/ReportOutlineSectionModel"
          },
          "maxItems": 15,
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "sections"
      ],
      "title": "ReportOutlineModel",
      "type": "object"
    },
    "ReportOutlineSectionModel": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "ReportOutlineSectionModel",
      "type": "object"
    },
    "ReportStatus": {
      "description": "Spiegelt models/report.py:ReportStatus 1:1.",
      "enum": [
        "pending",
        "planning",
        "generating",
        "incomplete",
        "completed",
        "failed"
      ],
      "title": "ReportStatus",
      "type": "string"
    }
  },
  "$id": "https://alexle135.de/schemas/report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Spiegelt models/report.py:Report \u2014 aber als Pydantic mit Validierung.",
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "evidence_sections": {
      "default": 0,
      "minimum": 0,
      "title": "Evidence Sections",
      "type": "integer"
    },
    "graph_id": {
      "minLength": 1,
      "title": "Graph Id",
      "type": "string"
    },
    "has_evidence": {
      "default": false,
      "title": "Has Evidence",
      "type": "boolean"
    },
    "markdown_content": {
      "default": "",
      "title": "Markdown Content",
      "type": "string"
    },
    "missing_sections": {
      "items": {
        "type": "string"
      },
      "title": "Missing Sections",
      "type": "array"
    },
    "outline": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportOutlineModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "simulation_id": {
      "minLength": 1,
      "title": "Simulation Id",
      "type": "string"
    },
    "simulation_requirement": {
      "minLength": 1,
      "title": "Simulation Requirement",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReportStatus"
    }
  },
  "required": [
    "report_id",
    "simulation_id",
    "graph_id",
    "simulation_requirement",
    "status"
  ],
  "title": "ReportModel",
  "type": "object"
}
