{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependency-risk-exceptions.schema.json",
  "title": "Dependency Risk Exceptions",
  "description": "Maschinenlesbare Liste temporärer CVE/Advisory-Ausnahmen. CI prüft Deadlines automatisch.",
  "type": "object",
  "required": ["exceptions"],
  "additionalProperties": true,
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Exception"
      }
    }
  },
  "$defs": {
    "Exception": {
      "type": "object",
      "required": [
        "advisory_id",
        "package",
        "version_constraint",
        "severity",
        "reason",
        "blocker",
        "target_version",
        "owner",
        "deadline",
        "issue",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "advisory_id": {
          "type": "string",
          "description": "CVE- oder PYSEC-Bezeichner (z.B. CVE-2026-1839).",
          "pattern": "^(CVE-\\d{4}-\\d+|PYSEC-\\d{4}-\\d+|GHSA-[a-z0-9-]+)$"
        },
        "package": {
          "type": "string",
          "description": "PyPI-Paketname (kleingeschrieben)."
        },
        "version_constraint": {
          "type": "string",
          "description": "PEP-440-Versionsbeschränkung, die den Grund für den Pin erklärt."
        },
        "severity": {
          "type": "string",
          "enum": ["Critical", "High", "Medium", "Low", "unknown"],
          "description": "Schweregrad laut Advisory."
        },
        "reason": {
          "type": "string",
          "minLength": 20,
          "description": "Begründung, warum kein sofortiger Fix möglich ist."
        },
        "blocker": {
          "type": "string",
          "description": "Was den Fix blockiert (URL zu Upstream-Release oder Issue)."
        },
        "target_version": {
          "type": "string",
          "description": "Zielversion oder Bedingung, die die Ausnahme auflöst."
        },
        "owner": {
          "type": "string",
          "description": "Verantwortliche Person oder Team."
        },
        "deadline": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO-8601-Datum, bis zu dem die Ausnahme spätestens aufgelöst sein muss."
        },
        "issue": {
          "type": "string",
          "format": "uri",
          "description": "GitHub-Issue-URL, das den Stand trackt."
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "Aktueller Status der Ausnahme."
        }
      }
    }
  }
}
