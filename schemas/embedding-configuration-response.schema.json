{
  "$defs": {
    "EmbeddingConfiguration": {
      "additionalProperties": false,
      "description": "Kanonische Embedding-Konfiguration (SSoT).\n\nPro ``scope=\"global\"`` darf es hoechstens eine ``active`` Konfiguration\ngeben. Pro ``scope=\"project\"`` ebenfalls hoechstens eine ``active`` pro\n``project_id``. Diese Eindeutigkeit wird strukturell nicht erzwungen\n(sie wuerde einen Unique-Index in der Persistenz erfordern); sie ist\nAufgabe des ``EmbeddingConfigurationService`` in Slice 4.2.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dimensions": {
          "exclusiveMinimum": 0,
          "title": "Dimensions",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "index_version": {
          "minimum": 1,
          "title": "Index Version",
          "type": "integer"
        },
        "last_validated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Validated At"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "provider_connection_id": {
          "minLength": 1,
          "title": "Provider Connection Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "ollama",
            "openai",
            "google",
            "custom",
            "ollama_cloud",
            "openai_compatible"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "scope": {
          "enum": [
            "global",
            "project"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "probed",
            "reembedding",
            "validated",
            "active",
            "rolled_back",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Message"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider_connection_id",
        "provider_kind",
        "model_id",
        "dimensions",
        "scope",
        "index_version",
        "created_at",
        "updated_at"
      ],
      "title": "EmbeddingConfiguration",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/embedding-configuration-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Antwort-Wrapper analog zu ``ProviderConnectionResponse``.",
  "properties": {
    "configuration": {
      "$ref": "#/$defs/EmbeddingConfiguration"
    }
  },
  "required": [
    "configuration"
  ],
  "title": "EmbeddingConfigurationResponse",
  "type": "object"
}
