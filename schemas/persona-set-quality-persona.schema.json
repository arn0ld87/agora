{
  "$defs": {
    "PersonaSetQualityIssue": {
      "additionalProperties": false,
      "description": "Ein Qualitaetshinweis (Code und Schwere wie ``PersonaQualityService``).",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity"
      ],
      "title": "PersonaSetQualityIssue",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/persona-set-quality-persona.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hinweise zu einem Eintrag. Die Reihenfolge ist die der Eintraege im Satz.",
  "properties": {
    "entry_id": {
      "title": "Entry Id",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/PersonaSetQualityIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "username": {
      "title": "Username",
      "type": "string"
    }
  },
  "required": [
    "entry_id",
    "username",
    "issues"
  ],
  "title": "PersonaSetQualityPersona",
  "type": "object"
}
