{
  "$defs": {
    "PersonaSetQualityIssue": {
      "additionalProperties": false,
      "description": "Ein Qualitaetshinweis (Code und Schwere wie ``PersonaQualityService``).",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity"
      ],
      "title": "PersonaSetQualityIssue",
      "type": "object"
    },
    "PersonaSetQualityPersona": {
      "additionalProperties": false,
      "description": "Hinweise zu einem Eintrag. Die Reihenfolge ist die der Eintraege im Satz.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/PersonaSetQualityIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "username",
        "issues"
      ],
      "title": "PersonaSetQualityPersona",
      "type": "object"
    },
    "PersonaSetQualitySummary": {
      "additionalProperties": false,
      "description": "Verteilungskennzahlen des Satzes (ohne Review-Zaehler: Saetze kennen kein Review).",
      "properties": {
        "distinct_mbti": {
          "items": {
            "type": "string"
          },
          "title": "Distinct Mbti",
          "type": "array"
        },
        "distinct_roles": {
          "items": {
            "type": "string"
          },
          "title": "Distinct Roles",
          "type": "array"
        },
        "mbti_diversity": {
          "minimum": 0.0,
          "title": "Mbti Diversity",
          "type": "number"
        },
        "role_diversity": {
          "minimum": 0.0,
          "title": "Role Diversity",
          "type": "number"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "role_diversity",
        "mbti_diversity",
        "distinct_roles",
        "distinct_mbti"
      ],
      "title": "PersonaSetQualitySummary",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/persona-set-quality-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Antwort von ``GET /api/persona-sets/<set_id>/quality``.\n\nReine Heuristik ohne LLM-Aufruf und ohne Simulation. Hinweise sind\nHinweise: sie sperren nichts.",
  "properties": {
    "global_issues": {
      "items": {
        "$ref": "#/$defs/PersonaSetQualityIssue"
      },
      "title": "Global Issues",
      "type": "array"
    },
    "personas": {
      "items": {
        "$ref": "#/$defs/PersonaSetQualityPersona"
      },
      "title": "Personas",
      "type": "array"
    },
    "set_id": {
      "title": "Set Id",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/PersonaSetQualitySummary"
    }
  },
  "required": [
    "set_id",
    "summary",
    "global_issues",
    "personas"
  ],
  "title": "PersonaSetQualityReport",
  "type": "object"
}
