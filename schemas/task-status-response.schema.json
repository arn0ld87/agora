      "description": "Spiegel von ``app.models.task.TaskStatus``.\n\nBewusst dupliziert statt importiert: Contracts in diesem Paket haengen\nnicht von ``app.models`` ab (siehe z. B. ``ProjectStatus`` in\n``project_contract.py``, ``ReportStatus`` in ``report_contract.py``) \u2014\ndas haelt die Vertragsebene unabhaengig von der internen\nModell-Implementierung.",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "title": "TaskStatusValue",
      "type": "string"
    }
  },
