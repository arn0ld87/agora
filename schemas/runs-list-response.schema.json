{
  "$defs": {
    "BudgetWarning": {
      "additionalProperties": false,
      "description": "Auditierbare Warnung bei (weicher oder harter) Limit\u00fcberschreitung.",
      "properties": {
        "dimension": {
          "enum": [
            "tokens",
            "cost",
            "time",
            "calls"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "minimum": 0,
          "title": "Observed",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "soft",
            "hard"
          ],
          "title": "Severity",
          "type": "string"
        },
        "threshold": {
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        },
        "ts": {
          "minLength": 1,
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "severity",
        "threshold",
        "observed",
        "message",
        "ts"
      ],
      "title": "BudgetWarning",
      "type": "object"
    },
    "RunBudgetConfig": {
      "additionalProperties": false,
      "description": "Vom Nutzer gesetzte Budget-Limits f\u00fcr einen Run.\n\nAlle Limits optional; None bedeutet \u201ekein Limit\u201c. `enforcement` gilt\nf\u00fcr alle gesetzten Limits gemeinsam: soft = warnen und weiterlaufen,\nhard = weitere planbare Modellaufrufe deterministisch verhindern.",
      "properties": {
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "enforcement": {
          "default": "soft",
          "enum": [
            "soft",
            "hard"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "max_cost_micros": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Micros"
        },
        "max_duration_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration Seconds"
        },
        "max_llm_calls": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Llm Calls"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "RunBudgetConfig",
      "type": "object"
    },
    "RunBudgetStatus": {
      "additionalProperties": false,
      "description": "Aktueller Budget-Zustand eines Runs: Config + Verbrauch + Warnungen.",
      "properties": {
        "config": {
          "$ref": "#/$defs/RunBudgetConfig"
        },
        "consumed": {
          "$ref": "#/$defs/UsageMetrics"
        },
        "exceeded_dimension": {
          "anyOf": [
            {
              "enum": [
                "tokens",
                "cost",
                "time",
                "calls"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exceeded Dimension"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "warning",
            "exceeded"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/BudgetWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "config",
        "consumed"
      ],
      "title": "RunBudgetStatus",
      "type": "object"
    },
    "RunDetail": {
      "additionalProperties": true,
      "description": "Vollst\u00e4ndige Run-Repr\u00e4sentation mit optionalen Live-Metriken.",
      "properties": {
        "artifacts": {
          "additionalProperties": true,
          "title": "Artifacts",
          "type": "object"
        },
        "branch_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Label"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunBudgetStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "eta_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta Seconds"
        },
        "linked_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Linked Ids",
          "type": "object"
        },
        "log_tail": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Tail"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metrics": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "integer"
        },
        "resume_capability": {
          "additionalProperties": true,
          "title": "Resume Capability",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_type": {
          "title": "Run Type",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "processing",
            "paused",
            "completed",
            "failed",
            "stopped"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "termination_reason": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "error",
                "user_cancel",
                "user_stop",
                "budget_tokens",
                "budget_cost",
                "budget_time",
                "budget_calls"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Reason"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "run_type",
        "entity_id",
        "status",
        "progress",
        "started_at",
        "updated_at"
      ],
      "title": "RunDetail",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "description": "Lesepfad-Anreicherung: Felder aus Projekt + Simulation (N+1-gecacht).",
      "properties": {
        "branch_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Name"
        },
        "document_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Name"
        },
        "graph_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Id"
        },
        "graph_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Name"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "persona_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Count"
        }
      },
      "title": "RunSummary",
      "type": "object"
    },
    "RunUsage": {
      "additionalProperties": false,
      "description": "Tats\u00e4chlicher Verbrauch eines Runs, aufgeschl\u00fcsselt nach Stage/Provider/Modell.",
      "properties": {
        "by_model": {
          "additionalProperties": {
            "$ref": "#/$defs/UsageMetrics"
          },
          "title": "By Model",
          "type": "object"
        },
        "by_provider": {
          "additionalProperties": {
            "$ref": "#/$defs/UsageMetrics"
          },
          "title": "By Provider",
          "type": "object"
        },
        "by_stage": {
          "additionalProperties": {
            "$ref": "#/$defs/UsageMetrics"
          },
          "title": "By Stage",
          "type": "object"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "measurement_status": {
          "default": "unknown",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Measurement Status",
          "type": "string"
        },
        "pricing_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Source"
        },
        "pricing_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Version"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "totals": {
          "$ref": "#/$defs/UsageMetrics"
        }
      },
      "required": [
        "totals"
      ],
      "title": "RunUsage",
      "type": "object"
    },
    "RunsAggregation": {
      "additionalProperties": false,
      "description": "Status-Aggregation: Anzahl je kanonischem Status + Gesamtsumme.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "counts",
        "total"
      ],
      "title": "RunsAggregation",
      "type": "object"
    },
    "UsageMetrics": {
      "additionalProperties": false,
      "description": "Gemessener Verbrauch eines Runs oder einer Teilmenge (Stage/Provider/Modell).\n\nOptionale Felder bleiben None, wenn die Datenquelle sie nicht liefert \u2014\nder jeweilige Status macht die Datenqualit\u00e4t explizit.",
      "properties": {
        "cost_micros": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Micros"
        },
        "cost_status": {
          "default": "unknown",
          "enum": [
            "measured",
            "estimated",
            "free",
            "unknown"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "tokens_status": {
          "default": "unknown",
          "enum": [
            "measured",
            "partial",
            "unknown"
          ],
          "title": "Tokens Status",
          "type": "string"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "UsageMetrics",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/runs-list-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normierter List-Response f\u00fcr GET /api/runs.",
  "properties": {
    "aggregation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunsAggregation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunDetail"
      },
      "title": "Runs",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "runs",
    "total"
  ],
  "title": "RunsListResponse",
  "type": "object"
}
