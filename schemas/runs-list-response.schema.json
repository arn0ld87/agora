{
  "$defs": {
    "RunDetail": {
      "additionalProperties": true,
      "description": "Vollst\u00e4ndige Run-Repr\u00e4sentation mit optionalen Live-Metriken.",
      "properties": {
        "artifacts": {
          "additionalProperties": true,
          "title": "Artifacts",
          "type": "object"
        },
        "branch_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Label"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "eta_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta Seconds"
        },
        "linked_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Linked Ids",
          "type": "object"
        },
        "log_tail": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Tail"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metrics": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "integer"
        },
        "resume_capability": {
          "additionalProperties": true,
          "title": "Resume Capability",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_type": {
          "title": "Run Type",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "processing",
            "paused",
            "completed",
            "failed",
            "stopped"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "run_type",
        "entity_id",
        "status",
        "progress",
        "started_at",
        "updated_at"
      ],
      "title": "RunDetail",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "description": "Lesepfad-Anreicherung: Felder aus Projekt + Simulation (N+1-gecacht).",
      "properties": {
        "branch_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Name"
        },
        "document_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Name"
        },
        "graph_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Id"
        },
        "graph_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Name"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "persona_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Count"
        }
      },
      "title": "RunSummary",
      "type": "object"
    },
    "RunsAggregation": {
      "additionalProperties": false,
      "description": "Status-Aggregation: Anzahl je kanonischem Status + Gesamtsumme.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "counts",
        "total"
      ],
      "title": "RunsAggregation",
      "type": "object"
    }
  },
  "$id": "https://alexle135.de/schemas/runs-list-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normierter List-Response f\u00fcr GET /api/runs.",
  "properties": {
    "aggregation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunsAggregation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunDetail"
      },
      "title": "Runs",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "runs",
    "total"
  ],
  "title": "RunsListResponse",
  "type": "object"
}
